# Copy this file to .env and fill in your key. .env is gitignored.

# Enables the AI summary feature (POST /api/programs/:id/summarize).
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Hard cap on real (billed) summarize calls per day, shared across every
# visitor -- per-IP rate limiting alone doesn't bound total spend on a public
# demo. Once hit, the route returns 503 until the next UTC day. Default: 50.
SUMMARIZE_DAILY_LIMIT=50
